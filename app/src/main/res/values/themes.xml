<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Spark" parent="android:Theme.Material.Light.NoActionBar" />
    
    <!-- Solid Dark Overlay theme for Interceptor (Completely covers background app) -->
    <style name="Theme.Spark.Overlay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#07070B</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">1.0</item>
    </style>
</resources>